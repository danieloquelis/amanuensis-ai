{
  "name": "amanuensis-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "yarn sounds:fetch && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "check": "yarn format:check && yarn lint && yarn typecheck && yarn test && yarn test:integration",
    "smoke:assistant": "tsx --env-file=.env.local scripts/assistant-smoke.mts",
    "spike:voice": "tsx --env-file=.env.local scripts/voice-spike.mts",
    "eval:voice": "tsx scripts/voice-eval.mts",
    "test:integration": "tsx --test tests/integration/*.integration-test.ts",
    "smoke:voice": "tsx --env-file=.env.local scripts/voice-smoke.mts",
    "eval:rhythm": "tsx scripts/rhythm-oracle.mts",
    "experiment:readings": "tsx --env-file=.env.local scripts/reading-choice-experiment.mts",
    "experiment:score-format": "tsx --env-file=.env.local scripts/score-format-experiment.mts",
    "fit:singing": "tsx --env-file=.env.local scripts/fit-singing-model.mts",
    "sounds:fetch": "tsx scripts/fetch-sounds.mts",
    "postinstall": "tsx scripts/fetch-sounds.mts --optional",
    "icons": "tsx scripts/make-icons.mts",
    "eval:sheet-reading": "tsx --env-file=.env.local scripts/sheet-reading-eval.mts",
    "eval:sheet-agent": "tsx --env-file=.env.local scripts/sheet-agent-eval.mts",
    "eval:prompt-rules": "tsx --env-file=.env.local scripts/prompt-rules-eval.mts",
    "eval:api": "tsx --env-file=.env.local scripts/api-compare.mts",
    "eval:band": "tsx --env-file=.env.local scripts/band-eval.mts",
    "eval:compose": "tsx --env-file=.env.local scripts/compose-eval.mts",
    "eval:scope": "tsx --env-file=.env.local scripts/scope-gate-eval.mts",
    "readme:figures": "tsx --env-file=.env.local scripts/readme-figures.mts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "next": "16.4.3",
    "onnxruntime-node": "1.31.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "smplr": "^1.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "yarn@4.14.1"
}
